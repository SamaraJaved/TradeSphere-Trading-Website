PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Used by Nodemailer (Gmail) to send verification, password-reset, and
# trade-closed emails. EMAIL_APP_PASSWORD must be a Gmail App Password,
# not your regular account password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password
